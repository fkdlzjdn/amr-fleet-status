PORT=3100
FLEET_SSH_USER=syscon
# 기본 키: 서버 계정의 ~/.ssh/id_rsa
# FLEET_SSH_KEY=/absolute/path/to/private_key
# 필요한 경우 서버에서만 설정합니다. 브라우저/API로 반환하지 않습니다.
# FLEET_SSH_PASSWORD=
# FLEET_SSH_KEY_PASSPHRASE=
# 기본 호스트키 파일: ~/.ssh/known_hosts
# FLEET_KNOWN_HOSTS=/absolute/path/to/known_hosts
FLEET_INTERVAL_MS=30000
FLEET_CONCURRENCY=5
# DO 활성화는 true로 변경합니다. PIN 사용 여부는 별도 설정합니다.
# 실제 PIN은 이 예제가 아닌 서버의 .env에만 입력하세요.
DO_CONTROL_ENABLED=false
# false: PIN 없이 ON/OFF, true: 저장된 PIN으로 인증 후 사용
DO_CONTROL_PIN_REQUIRED=false
DO_CONTROL_PIN=
